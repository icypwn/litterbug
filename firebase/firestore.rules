rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /litter/{id} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
    match /users/{id} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
    match /trades/{id} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
